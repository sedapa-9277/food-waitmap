# 맛집 대기지도 설정 견본
# 이 파일을 .env로 복사해 값을 채운 뒤 아래 명령으로 waitmap/js/config.js를 만든다.
#   powershell -ExecutionPolicy Bypass -File scripts/build-config.ps1
# .env는 git에 올라가지 않는다(.gitignore). config.js는 GitHub Pages 배포에 필요하므로 커밋한다.
#
# 주의: config.js는 브라우저로 그대로 전달된다. 여기에는 공개되어도 되는 값만 넣는다.
#   - Supabase: publishable 키만. service_role/secret 키 금지
#   - 카카오: JavaScript 키만(등록 도메인에서만 동작). REST API 키·Admin 키 금지

# Supabase 프로젝트 주소와 공개용(publishable) 키
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# 카카오 JavaScript 키(카카오 지도 + 식당 정보 조회). 비워 두면 지도가 뜨지 않는다
KAKAO_JS_KEY=
